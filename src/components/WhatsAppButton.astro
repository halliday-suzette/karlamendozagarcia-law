	target="_blank"
	rel="noopener noreferrer"
	aria-label="Contáctame por WhatsApp"
	data-analytics="whatsapp-float-click"
	class="fixed bottom-5 right-5 z-50 flex items-center gap-2 rounded-full bg-[#25D366] py-3 pl-3 pr-4 font-sans text-sm font-semibold text-white shadow-lg shadow-ink/30 transition-transform hover:scale-105 motion-reduce:transition-none sm:bottom-6 sm:right-6"
>
