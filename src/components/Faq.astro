---
import { faqItems } from "../lib/faq";
---

<section
	id="preguntas-frecuentes"
	class="scroll-mt-20 bg-paper-deep px-4 py-20 sm:px-6 sm:py-28"
>
	<div class="mx-auto max-w-3xl" data-reveal>
		<h2 class="font-serif text-3xl text-ink sm:text-4xl">Preguntas frecuentes</h2>

		<dl class="mt-12 space-y-8">
			{
				faqItems.map((item) => (
					<div>
						<dt class="font-serif text-lg text-ink">{item.question}</dt>
						<dd class="mt-2 text-base leading-relaxed text-ink-soft">{item.answer}</dd>
					</div>
				))
			}
		</dl>
	</div>
</section>
