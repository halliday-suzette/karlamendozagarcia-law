---
import NotarialSeal from "./NotarialSeal.astro";

const items = [
	{
		label: "Formación académica",
		value:
			"Licenciada en Derecho — Universidad Nacional Autónoma de Nicaragua (UNAN-León), Facultad de Ciencias Jurídicas y Sociales, 2003.",
	},
	{
		label: "Afiliación profesional",
		value: "Miembro de la Asociación de Abogados.",
	},
	{
		label: "Credencial oficial",
		value:
			"Abogado y Notario Público — Carné CSJ No. 14680, Corte Suprema de Justicia de la República de Nicaragua.",
	},
];
---

<section id="credenciales" class="scroll-mt-20 bg-paper px-4 py-20 sm:px-6 sm:py-28">
	<div class="mx-auto max-w-6xl" data-reveal>
		<h2 class="font-serif text-3xl text-ink sm:text-4xl">Formación y credenciales</h2>

		<div class="mt-12 grid gap-16 md:grid-cols-2 md:items-center md:gap-12">
			<dl class="space-y-6">
				{
					items.map((item) => (
						<div class="border-b border-ink-soft/15 pb-4">
							<dt class="font-mono text-xs uppercase tracking-wider text-brass-deep">
								{item.label}
							</dt>
							<dd class="mt-1 font-serif text-lg text-ink">{item.value}</dd>
						</div>
					))
				}
			</dl>

			<div class="flex justify-center">
				<NotarialSeal />
			</div>
		</div>
	</div>
</section>
