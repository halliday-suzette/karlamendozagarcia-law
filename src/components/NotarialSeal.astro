---
// Original seal design — not a reproduction of any official government emblem.
// Ring text is placed character-by-character along the circle using trigonometry
// rather than <textPath>, so orientation is exact and rendering is consistent
// across browsers.

const CX = 100;
const CY = 100;
const TEXT_RADIUS = 80;

type ArcChar = { char: string; x: number; y: number; rotation: number };

function arcChars(
	text: string,
	startAngle: number,
	endAngle: number,
	radius: number,
	flip: boolean,
): ArcChar[] {
	const chars = [...text];
	const n = chars.length;
	return chars.map((char, i) => {
		const t = n === 1 ? 0.5 : i / (n - 1);
		const angle = startAngle + t * (endAngle - startAngle);
		const rad = (angle * Math.PI) / 180;
		const x = CX + radius * Math.sin(rad);
		const y = CY - radius * Math.cos(rad);
		const rotation = flip ? angle + 180 : angle;
		return { char, x, y, rotation };
	});
}

// Top arc: natural order, reads left-to-right across the top.
const topChars = arcChars("CORTE SUPREMA DE JUSTICIA", -80, 80, TEXT_RADIUS, false);

// Bottom arc: start angle is the left end, end angle is the right end, so the
// string still reads left-to-right while each glyph is flipped upright.
const bottomChars = arcChars("REPÚBLICA DE NICARAGUA", 258, 102, TEXT_RADIUS, true);

const ariaLabel =
	"Sello notarial de Lic. Karla Mendoza García — Carné CSJ No. 14680, Corte Suprema de Justicia, República de Nicaragua";
---

<figure class="flex flex-col items-center">
	<div
		class="motion-safe:transition-transform motion-safe:duration-500 motion-safe:ease-out motion-safe:hover:-rotate-2 motion-safe:hover:scale-105"
	>
		<svg
			viewBox="0 0 200 200"
			class="h-56 w-56 sm:h-64 sm:w-64"
			role="img"
			aria-label={ariaLabel}
		>
			<g aria-hidden="true">
				<circle
					cx={CX}
					cy={CY}
					r="94"
					fill="none"
					stroke="currentColor"
					class="text-brass-deep"
					stroke-width="2"
				/>
				<circle
					cx={CX}
					cy={CY}
					r="88"
					fill="none"
					stroke="currentColor"
					class="text-brass"
					stroke-width="1"
				/>
				<circle
					cx={CX}
					cy={CY}
					r="62"
					fill="none"
					stroke="currentColor"
					class="text-brass"
					stroke-width="1"
				/>

				<circle cx={CX} cy="18" r="2.5" fill="currentColor" class="text-brass" />
				<circle cx={CX} cy="182" r="2.5" fill="currentColor" class="text-brass" />

				{
					topChars.map(({ char, x, y, rotation }) => (
						<text
							x={x}
							y={y}
							transform={`rotate(${rotation}, ${x}, ${y})`}
							text-anchor="middle"
							class="fill-brass-deep font-mono text-[9px] font-medium"
						>
							{char}
						</text>
					))
				}
				{
					bottomChars.map(({ char, x, y, rotation }) => (
						<text
							x={x}
							y={y}
							transform={`rotate(${rotation}, ${x}, ${y})`}
							text-anchor="middle"
							class="fill-brass-deep font-mono text-[9px] font-medium"
						>
							{char}
						</text>
					))
				}

				<g class="text-brass" stroke="currentColor" stroke-width="1.4" fill="none">
					<line x1={CX} y1="58" x2={CX} y2="92" />
					<line x1="80" y1="66" x2="120" y2="66" />
					<line x1="80" y1="66" x2="68" y2="88" />
					<line x1="80" y1="66" x2="92" y2="88" />
					<path d="M68 88 a12 9 0 0 0 24 0" />
					<line x1="120" y1="66" x2="108" y2="88" />
					<line x1="120" y1="66" x2="132" y2="88" />
					<path d="M108 88 a12 9 0 0 0 24 0" />
				</g>

				<text
					x={CX}
					y="122"
					text-anchor="middle"
					class="fill-brass-deep font-mono text-[7px] uppercase tracking-widest"
				>
					Carné CSJ
				</text>
				<text
					x={CX}
					y="140"
					text-anchor="middle"
					class="fill-ink font-mono text-[15px] font-semibold tracking-wider"
				>
					Nº 14680
				</text>
			</g>
		</svg>
	</div>

	<figcaption class="mt-4 max-w-xs text-center text-sm text-ink-soft">
		Credencial notarial oficial otorgada por la Corte Suprema de Justicia de la
		República de Nicaragua. Con este número, clientes y juzgados pueden verificar su
		inscripción como Abogado y Notario Público.
	</figcaption>
</figure>
