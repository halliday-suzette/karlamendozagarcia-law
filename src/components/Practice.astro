const areas = [
	{
		title: "Trámites notariales",
		description:
			"Escrituras, autenticaciones y demás diligencias que requieren la fe pública de un notario.",
	},
	{
		title: "Derecho civil y de familia",
		description:
			"Asesoría en asuntos civiles y de familia, con un trato cercano y claro en cada etapa del proceso.",
	},
	{
		title: "Contratos",
		description:
			"Elaboración y revisión de contratos, cuidando que cada cláusula sea clara y proteja sus intereses.",
	},
	{
		title: "Bienes raíces",
		description:
			"Acompañamiento legal en compraventas, traspasos y demás gestiones relacionadas con propiedades.",
	},
	{
		title: "Poderes y representación",
		description:
			"Otorgamiento de poderes generales y especiales para trámites dentro y fuera de Nicaragua.",
