---

<section
	id="areas-de-practica"
	class="scroll-mt-20 bg-paper px-4 py-20 sm:px-6 sm:py-28"
>
	<div class="mx-auto max-w-6xl" data-reveal>
		<h2 class="font-serif text-3xl text-ink sm:text-4xl">Áreas de práctica</h2>

		<ul class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
			{
				areas.map((area) => (
					<li class="rounded-sm border border-ink-soft/15 bg-paper-deep p-6">
						<h3 class="font-serif text-lg text-ink">{area.title}</h3>
						<p class="mt-2 text-sm leading-relaxed text-ink-soft">
							{area.description}
						</p>
					</li>
				))
			}
		</ul>
	</div>
</section>
